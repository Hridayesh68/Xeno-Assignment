# Database - using SQLite for local dev (change to postgresql:// for production)
DATABASE_URL=sqlite:///./xeno_crm.db

# Redis (optional for local dev - not required for basic operation)
REDIS_URL=redis://localhost:6379/0

# OpenAI (optional - features degrade gracefully without it)
OPENAI_API_KEY=

# Channel Stub URL
CHANNEL_STUB_URL=http://localhost:8001

# This service URL (for channel stub to call back)
CRM_BASE_URL=http://localhost:8000

# Environment
ENVIRONMENT=development
