# ──────────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────
# Direct connection URL to your Supabase PostgreSQL instance.
# Example: postgresql://postgres.xxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]

# ──────────────────────────────────────────────────────────────────────────────
# JWT AUTHENTICATION
# ──────────────────────────────────────────────────────────────────────────────
# Secret key to sign JWT tokens. Run `openssl rand -hex 32` to generate one.
SECRET_KEY=change_me_in_production_with_a_secure_random_string_64_chars

# ──────────────────────────────────────────────────────────────────────────────
# INTEGRATION API KEYS
# ──────────────────────────────────────────────────────────────────────────────
# Gemini API Key (Fallback for marketing copilot agents)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Primary for marketing copilot agents)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (Optional alternative LLM runner)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ──────────────────────────────────────────────────────────────────────────────
# SERVICE ROUTING & PORTS
# ──────────────────────────────────────────────────────────────────────────────
# Ports (defaults for local dev)
PORT=8001

# --- Docker Compose Environment Configuration (Recommended for production) ---
# Routing via Docker Network using internal service discovery names
CHANNEL_STUB_URL=http://channel-service:8001
CRM_BASE_URL=http://crm-api:8000
CRM_RECEIPT_URL=http://crm-api:8000/api/receipt

# --- Local Environment Configuration (Use when running directly via python) ---
# CHANNEL_STUB_URL=http://localhost:8001
# CRM_BASE_URL=http://localhost:8000
# CRM_RECEIPT_URL=http://localhost:8000/api/receipt

# ──────────────────────────────────────────────────────────────────────────────
# RUNTIME ENVIRONMENT
# ──────────────────────────────────────────────────────────────────────────────
# Environment selector: 'production' or 'development'
ENVIRONMENT=production
